# Normalize line endings: LF everywhere except Windows-only scripts.
* text=auto eol=lf
# Redundant under the rule above, but stated explicitly: a CRLF checkout of a
# /bin/sh hook is `bad interpreter` on POSIX, i.e. a silently absent gate.
/.githooks/** text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Named divergence from the article template, kept from before the sync:
# The licence is the canonical CC BY-NC-ND 4.0 legalcode, byte-for-byte as fetched from
# creativecommons.org. Pin its bytes, so a checkout with core.autocrlf=true never rewrites its line
# endings and its sha256 still reproduces.
LICENSE -text
